// Design Ref: docs/02-design/features/multi-store-support.design.md §3.1
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id             String   @id @default(uuid())
  merchantId     String   @unique
  name           String
  businessNumber String?
  status         String   @default("active")
  posToken       String?  @unique // 매장별 POS 탭앱 인증 토큰(64자 hex, X-Store-Token 헤더로 검증)
  erpStoreCode   String?  @unique // 쉐보레 전산 측 매장 코드. 전산이 이 값으로 매장을 지정한다.
  // 홍보 문자 시연 모드가 켜져 있는 마지막 시각. 이 시각 전까지 이 매장은 "같은 번호 30일 내 재발송
  // 금지"를 적용하지 않는다(시연할 때 같은 번호로 여러 번 보내 보기 위해). 수신 동의·수신거부·야간 금지는
  // 그대로다. 켜면 그날 자정(KST)까지로 잡혀 저절로 꺼진다 -- 켜 둔 채 잊어도 다음 날엔 원래대로 돌아온다.
  promoDemoUntil DateTime?
  createdAt      DateTime @default(now())

  reservations  Reservation[]
  payments      Payment[]
  queueCounters QueueCounter[]
  adminUsers    AdminUser[]
  erpOrders     ErpOrder[]
  erpCarts      ErpCart[]
  promoSends    PromoSend[]
  marketingOptOuts MarketingOptOut[]
}

// Design Ref: docs/02-design/features/multi-store-support.design.md Phase 3
// role: "hq_admin"(storeId 없음, 전체 매장 접근) | "store_admin"(storeId 필수, 자기 매장만)
model AdminUser {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  role             String
  storeId          String?
  store            Store?    @relation(fields: [storeId], references: [id])
  failedLoginCount Int       @default(0) // 로그인 실패 누적 횟수. 성공 시 0으로 리셋된다.
  lockedUntil      DateTime? // 5회 실패 시 이 시각까지 로그인 자체를 막는다(423 응답).
  createdAt        DateTime  @default(now())
  lastLoginAt      DateTime?
}

model Reservation {
  id             String    @id @default(uuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  carNumber      String
  phone          String
  serviceType    String
  queueNumber    Int
  serviceDate    String // 접수 시점 KST 날짜 'YYYY-MM-DD'. 대기열/조회를 "오늘 것만"으로 한정할 때 쓴다.
  idempotencyKey String?   @unique
  status         String    @default("waiting") // waiting | called | notify_failed | completed | cancelled
  createdAt      DateTime  @default(now())
  calledAt       DateTime?
  completedAt    DateTime?

  privacyConsentAt   DateTime? // 개인정보 수집·이용 동의 시각
  marketingConsentAt DateTime? // 광고성 정보 수신 동의 시각(선택) — null이면 프로모션 발송 대상에서 제외
  anonymizedAt       DateTime? // 보관기간(DATA_RETENTION_DAYS) 경과 후 파기(익명화) 시각
  historyHiddenAt    DateTime? // 탭앱 [정비 이력]에서 숨긴 시각(리허설·테스트 기록 정리용). 대기열·관리자 웹에는 영향 없음

  erpCarts ErpCart[]

  intakeNotifyStatus String? // null = 정상/미시도, 'failed' = 접수(대기번호) 알림톡 발송 실패. 성공 시엔
  // 아무것도 쓰지 않는다(null 유지) — 해피패스에 DB 쓰기를 늘리지 않기 위함(계약 v3 §1).

  @@index([storeId])
  @@index([storeId, serviceDate, status])
  @@index([storeId, createdAt])
  @@index([storeId, phone])
  @@index([storeId, intakeNotifyStatus])
}

model Payment {
  id             String    @id @default(uuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  paymentKey     String?   @unique
  carNumber      String?
  serviceType    String?
  phone          String?
  amount         Int?
  status         String    @default("requested") // requested | receipt_sent | receipt_failed | cancelled
  promoAt        DateTime
  promoSent      Boolean   @default(false)
  promoSentAt    DateTime?
  promoClaimedAt DateTime?
  createdAt      DateTime  @default(now())

  privacyConsentAt   DateTime?
  marketingConsentAt DateTime?
  anonymizedAt       DateTime?

  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([storeId, phone])
  @@index([promoAt, promoSent, promoClaimedAt])
}

// Design Ref: Phase 4 결제 웹훅 수신. x-toss-webhook-id로 중복 수신을 막는다
// (토스 쪽에서 같은 이벤트를 재전송할 수 있다고 문서에 명시되어 있음).
model WebhookEvent {
  id          String   @id // x-toss-webhook-id 값 그대로 사용
  eventType   String
  receivedAt  DateTime @default(now())

  // 개인정보 자체는 거의 없지만(id는 토스가 발급한 웹훅 id) 중복 수신 방지 목적상 계속 쌓여서
  // 무한 증가한다. 보관기간이 지나면 다른 모델처럼 익명화할 것도 없으니 그냥 행을 지운다
  // (purgeExpiredWebhookEvents). receivedAt으로 대상을 찾으므로 인덱스를 둔다.
  @@index([receivedAt])
}

// Plan SC: FR-06 — 매장/날짜별 원자적 채번으로 동시 예약 요청 시 중복 대기번호 방지
model QueueCounter {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  date    String
  counter Int    @default(0)

  @@unique([storeId, date])
}

model RateLimitHit {
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
}

// 쉐보레 전산(ERP) -> 우리 -> 토스 주문 생성 중개 기록 (ERP_CONTRACT_V1 §2.2).
// referenceId(전산 측 주문 참조번호)가 멱등키다 — 같은 값으로 재호출해도 토스에 중복 주문을
// 만들지 않는다(tossOrderKey를 referenceId에서 안정적으로 파생시켜 재시도해도 동일하게 만든다).
model ErpOrder {
  id           String    @id @default(uuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id])
  referenceId  String    @unique // 전산 측 주문 참조번호 = 멱등키
  tossOrderKey String    @unique // 토스로 보낸 orderKey (referenceId에서 파생, 안정적)
  tossOrderId  String? // 토스가 돌려준 주문 id (응답 스키마 미확정이라 nullable)
  totalAmount  Int
  status       String    @default("created") // created | failed | paid
  itemsJson    String // 전산이 보낸 items 원본 JSON (감사/디버깅/결제통보 회신용)
  memo         String?
  tossRawJson  String? // 토스 응답 원본(성공/실패 모두) — 스키마 미확정이라 통째로 보관
  errorMessage String?
  createdAt    DateTime  @default(now())
  paidAt       DateTime?

  // memo/itemsJson에 전산이 보낸 차량번호·고객명이 그대로 들어간다(개인정보). 보관기간(3년)이
  // 지나면 purgeExpiredPersonalData가 이 시각을 찍고 memo를 지운다 — Reservation/Payment와
  // 같은 "레코드는 남기고 개인정보만 지우는" 방식(매장별 주문 건수 통계가 깨지지 않게).
  anonymizedAt DateTime?

  @@index([storeId, createdAt])
  @@index([status])
}

// 전산(ERP) "물건 담기" -> POS 플러그인 폴링 연동 (POS-CART-BRIDGE §1). ErpOrder(토스 Open API로
// 주문 자체를 생성하는 기존 경로)와는 완전히 별개다 -- 그 경로로 만든 주문은 POS에서 결제할 수
// 없다는 게 실증됐다(docs/ERP연동-결제경로-조사결과.md). 이 테이블은 "전산이 담아둔 장바구니"를
// POS 플러그인이 가져가 posPluginSdk.draftOrder.addLineItem()으로 POS 자체 장바구니에 직접 옮겨
// 담게 하는 중계용 큐일 뿐, 토스와는 아무것도 통신하지 않는다.
model ErpCart {
  id           String    @id @default(uuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id])
  referenceId  String    @unique // 전산 측 참조번호 = 멱등키
  itemsJson    String              // items 배열 원본 JSON
  totalAmount  Int
  memo         String?
  autoPay      Boolean   @default(true)
  // pending | loaded | failed | dismissed | expired | cancelled | paid | paying(프론트 결제 진행 중)
  // | refund_requested(프론트 결제 취소 요청됨) | refunding(프론트에서 취소 진행 중) | refunded(결제 취소됨)
  status       String    @default("pending")
  errorMessage String?
  createdAt    DateTime  @default(now())
  loadedAt     DateTime?

  // 전산이 보낸 차량번호. memo에도 같은 값이 들어가지만 그건 사람이 POS 화면에서 읽는 자유
  // 문자열이라 기계가 확실히 못 읽는다. 예약 손님과 잇는 데는 이 필드를 쓴다.
  carNumber      String?
  // 접수 당시 그날 대기 중이던 예약과 자동으로 이어진 결과. 확실할 때만(정확히 1건 일치) 붙인다 —
  // 잘못 이으면 남의 정비 이력에 부품이 붙고 자동완료로 엉뚱한 손님이 대기열에서 사라진다.
  reservationId  String?
  reservation    Reservation? @relation(fields: [reservationId], references: [id])

  // POS에서 실제 결제가 끝났을 때 채워진다. Payment 테이블에 넣지 않는 이유: 그쪽은 고객에게
  // 개인정보·광고 수신 동의를 받은 흐름이고, 전산 결제는 POS에서 동의 없이 일어난다.
  // 동의 없는 레코드를 그 파이프라인에 섞으면 프로모션 대상 판정이 흐려진다.
  paidAt         DateTime?
  tossPaymentId  String?
  tossOrderId    String?

  // 어디서 결제하는지. 'pos'(기존: POS 탭앱이 담아서 POS 결제) | 'front'(플러그인 모드 프론트가
  // 직접 결제). 토스는 프론트 플러그인과 토스 POS 동시 연결을 지원하지 않아서, 프론트 결제 건은
  // POS를 거치지 않고 프론트가 서버에서 바로 가져가 결제한다. POS 탭앱에는 'pos' 건만 내려간다.
  payTarget        String    @default("pos")
  // 프론트가 결제를 시작할 때 붙이는 paymentKey(sdk.payment.requestPayment에 넘긴 값). 결제 결과
  // 보고는 이 값이 맞을 때만 받는다 -- 다른 시도의 늦은 보고가 현재 시도를 덮어쓰지 못하게 한다.
  frontPaymentKey  String?   @unique
  frontPayingAt    DateTime?
  // 승인 결과 중 나중에 취소·대사에 필요한 값만 추려 JSON으로 남긴다(승인번호, 승인시각, 결제수단 등).
  frontPaymentJson String?
  // 프론트 결제의 승인번호. 토스 결제 웹훅과 맞춰보는 열쇠라 JSON과 별도로 둔다(인덱스).
  frontApprovalNo  String?

  // 토스 결제내역 매핑. 토스 웹훅(payment.payment.approved.v1)으로 같은 결제가 들어온 것을 확인한
  // 시각. tossPaymentId(위)가 토스 결제 ID다. null이면 "우리는 결제됐다고 알지만 토스 쪽 기록은
  // 아직 못 봤다"는 뜻이다 -- 위조된 결제 보고나 웹훅 누락을 잡는 데 쓴다.
  tossVerifiedAt   DateTime?

  // 결제 취소
  refundRequestedAt DateTime?
  refundedAt        DateTime?
  refundNote        String?   // 누가 어떻게 취소했는지(POS 취소 / 프론트 취소 / 현금 환불 / 토스 취소 확인)
  // 쓰지 않음. 페이스페이를 카드 취소 화면으로 띄우는 실험(2026-10-22)에 썼다가 실패해 코드를 뺐다. 배포 중 옛 인스턴스가
  // 이 컬럼을 읽을 수 있어 바로 지우지 않았다 -- 다음 정리 때 DROP COLUMN 해도 된다.
  refundMode        String?

  // 결제 후 전자영수증 알림톡 결과. sent | failed | no_reservation(예약과 이어지지 않아 번호를 모름) |
  // no_phone. 관리자 웹 전산 주문 이력에 보여 "영수증이 안 왔어요"의 원인을 바로 알 수 있게 한다.
  receiptStatus     String?

  // 탭앱 정리용. hiddenAt: [최근 결제]·[정비 이력]에서 숨김(다시 보이게 할 수 있다, 관리자 웹·합계에는 남는다).
  // deletedAt: 삭제 -- 탭앱·오늘 현황 합계·관리자 웹 목록 어디에도 안 나온다. 행은 지우지 않는다: 실제 돈이
  // 오간 결제라 카드사·토스 분쟁이나 대사 때 근거가 있어야 한다(전산의 상태 조회도 그대로 답한다).
  hiddenAt          DateTime?
  deletedAt         DateTime?

  @@index([storeId, status, createdAt])
  @@index([storeId, payTarget, status, createdAt])
  @@index([storeId, carNumber])
  @@index([storeId, frontApprovalNo])
  @@index([tossPaymentId])
}

// 토스 결제 웹훅으로 받은 결제 기록. 토스 Open API에는 "결제 목록 조회"가 없어서(단건·주문별 조회만
// 있다) 나중에 한꺼번에 대사할 수 없다. 그래서 웹훅이 올 때마다 남겨두고, 전산 주문과 양방향으로
// 맞춘다: 웹훅이 먼저 오면 나중에 프론트 결제 보고가 이걸 찾아 잇고, 보고가 먼저면 웹훅이 주문을 찾아 잇는다.
// 카드번호 등 결제수단 세부 정보는 저장하지 않는다(매핑에 필요 없다).
model TossPayment {
  id          String    @id // 토스 결제 ID
  merchantId  String
  storeId     String?   // 등록되지 않은 merchantId면 null
  orderId     String?   // 토스 주문 ID
  state       String    // APPROVED | CANCELLED
  sourceType  String?
  amount      Int?
  approvedNo  String?
  approvedAt  DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([storeId, approvedNo])
  @@index([createdAt])
}

// 매장 직원이 POS 이력 화면에서 손으로 보낸 홍보 메시지 기록.
//
// 자동 발송(Payment.promoSent, 결제 3개월 뒤)과 왜 따로 두나:
//   - 전산으로만 정비받은 손님은 Payment 레코드가 없다. 자동 발송 대상이 아니지만
//     수동으로는 보낼 수 있어야 한다(동의가 있다면).
//   - 광고 발송은 "누가 언제 누구에게 보냈는지"가 남아야 한다. 분쟁이 생기면 이 기록이
//     근거가 된다. 결제 레코드의 플래그 하나로는 그걸 담을 수 없다.
//   - 같은 손님에게 반복 발송하는 걸 막으려면 발송 시각이 남아 있어야 한다.
//
// phone을 저장하는 이유: 나중에 그 번호로 발송했는지 확인해야 하는데, 예약/결제 레코드가
// 개인정보 파기로 익명화되면 되짚을 수 없게 된다. 이 테이블도 같은 파기 대상에 넣는다.
model PromoSend {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  carNumber String?
  phone     String?
  sentBy    String? // 보낸 사람(관리자 계정 id). POS 탭앱에서 보낸 건 매장 단위라 null이다.
  sentAt    DateTime @default(now())
  // 기록을 먼저 남기고(sending) 발송 결과로 바꾼다. sent(나감) | failed(확실히 안 나감 -- 30일 제한에서
  // 빠진다) | unknown(시간 초과 등 결과를 모름 -- 나갔을 수 있어 30일 제한에 넣는다). 결과를 쓰기 전에
  // 프로세스가 죽어 sending으로 남은 건도 나갔을 수 있으므로 30일 제한에 넣는다.
  status    String   @default("sent")
  via       String? // auto(결제 3개월 뒤) | manual(POS 차량별) | campaign-admin | campaign-pos
  consentAt DateTime? // 이 발송의 근거가 된 광고 수신 동의 시각(가장 최근 기록의 marketingConsentAt)

  anonymizedAt DateTime? // 보관기간 경과 후 phone/carNumber를 지운 시각

  @@index([storeId, carNumber, sentAt])
  @@index([storeId, phone, sentAt])
  @@index([storeId, sentAt])
}

// 광고 수신거부(동의 철회). 손님이 매장에 거부를 알려오면 직원이 POS 탭앱이나 관리자 웹에서 등록한다.
// 등록된 번호에는 자동·수동·기간 지정 어떤 광고도 보내지 않는다. 등록한 뒤에 다시 방문해 광고 수신에
// 새로 동의했다면(동의 시각 > optedOutAt) 그 동의를 따른다.
//
// 예약·결제 기록과 달리 보관기간이 지나도 지우지 않는다 -- 지우면 옛 동의 기록이 다시 살아나 거부한
// 손님에게 광고가 나갈 수 있다. 거부 의사를 지키는 데 필요한 최소 정보(번호, 시각)만 둔다.
model MarketingOptOut {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  phone      String
  optedOutAt DateTime @default(now())
  recordedBy String? // 등록한 관리자 id. POS 탭앱에서 등록한 건 매장 단위라 null이다.
  via        String? // pos | admin

  @@unique([storeId, phone])
}
