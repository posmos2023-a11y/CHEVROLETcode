PORT=3000

# 배포 플랫폼의 로드밸런서/프록시 홉 수. Render, GCP Cloud Run/App Engine 등 대부분의 PaaS는
# 1홉(로드밸런서 1개)이라 기본값 1이면 충분하다. express-rate-limit이 개별 클라이언트 IP를
# 올바르게 구분하려면 이 값이 실제 프록시 구성과 맞아야 한다(안 맞으면 레이트리밋이 전체
# 트래픽에 뭉뚱그려 적용됨). 로컬 개발(프록시 없음)에서는 0으로 바꿔도 되지만 안 바꿔도 무방하다.
TRUST_PROXY_HOPS=1

# DB. Cloud SQL for PostgreSQL 연결 문자열.
# 로컬 개발 시 postgres 컨테이너(docker run -e POSTGRES_PASSWORD=devpass -e POSTGRES_DB=devdb -p 5432:5432 postgres:16-alpine)
# 등으로 대체 가능. GCP 배포 시 Cloud SQL 연결 문자열로 교체 (docs/gcp-migration-and-scale-plan.md 참고).
#
# Cloud Run 커넥션 풀 주의: Prisma는 인스턴스(프로세스)마다 자체 커넥션 풀을 갖는다. 기본 풀 크기는
# `num_physical_cpus * 2 + 1`인데, Cloud Run은 트래픽에 따라 인스턴스를 여러 개로 자동 확장하므로
# "인스턴스 수 × 풀 크기"가 순식간에 Cloud SQL의 max_connections(기본 100 안팎)를 넘길 수 있다.
# 연결 문자열 끝에 `?connection_limit=`을 붙여 인스턴스당 풀 크기를 명시적으로 낮게 고정할 것
# (예: `?schema=public&connection_limit=5`). Cloud Run 최대 인스턴스 수 × connection_limit이
# Cloud SQL 한도보다 여유 있게 작아야 한다. 자세한 계산은 docs/gcp-migration-and-scale-plan.md 참고.
DATABASE_URL="postgresql://postgres:devpass@localhost:5432/devdb?schema=public"

# 솔라피 (알림톡)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
SOLAPI_KAKAO_PFID=

# 알림톡/문자 발송 API 호출 타임아웃(ms). 미설정 시 기본값 10000(10초). 양수가 아니면(0, 음수,
# 문자 등) 기본값으로 대체된다(음수를 그대로 두면 setTimeout이 즉시 발화해 모든 발송이 타임아웃으로
# 실패하는데, 로그만 보면 "문자 회사가 느리다"로 오인하기 쉽다). 솔라피 응답이 평소보다 느려서
# 정상 발송 건까지 타임아웃으로 실패 처리되는 것 같을 때(발송 실패 로그가 급증할 때) 올려서 임시
# 완화할 수 있다. 반대로 낮추면 실패 판정이 더 빨리 나서 재시도 버튼을 더 빨리 누를 수 있게 된다.
SOLAPI_TIMEOUT_MS=10000

# 예약 접수 시 대기번호+남은 인원 안내 (대기중인 손님이 있을 때만 발송. 없으면 바로 순서 호출 템플릿이 나감)
SOLAPI_KAKAO_TEMPLATE_RESERVATION=
# 매장에서 순서를 호출할 때 "고객님의 순서입니다" 안내
SOLAPI_KAKAO_TEMPLATE_QUEUE_TURN=
# 결제 완료 전자영수증
SOLAPI_KAKAO_TEMPLATE_RECEIPT=
# 결제 3개월 후 자동 발송되는 홍보 알림톡
SOLAPI_KAKAO_TEMPLATE_PROMO=

# 관리자 로그인(JWT) 서명 키. 운영 배포에서는 반드시 긴 랜덤 문자열로 고정해야 한다.
# 비워두면 로컬 개발 편의를 위해 서버가 매 부팅마다 임시 값을 자동 생성한다(재시작 시 기존 로그인 세션은 무효화됨).
JWT_SECRET=

# 최초 부팅 시 자동 생성되는 본사(hq_admin) 계정. 비워두면 admin@local + 무작위 비밀번호(콘솔에 1회 출력)로 생성된다.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# 로컬 개발/토스프론트 미리보기용 테스트 매장(merchantId '0')을 부팅 시 자동 시드할지 여부.
# 기본적으로 NODE_ENV=production에서는 이 시드를 만들지 않는다(실제 매장 등록 절차를 우회하는
# 가짜 매장이 운영 DB에 생기는 걸 막기 위해서) — 로컬/스테이징(NODE_ENV != production)에서는
# 이 값과 무관하게 항상 시드된다. 운영 Cloud Run 컨테이너에서 정말로 이 테스트 매장이 필요한
# 특수한 경우(예: 실제 매장 온보딩 전 운영 환경 자체를 점검)에만 `true`로 설정한다 — 평소에는
# 비워둘 것.
ALLOW_TEST_STORE=

# 토스플레이스 결제 웹훅(POST /api/webhooks/toss/payment) 서명 검증 키.
#
# ⚠️ 이 값은 "토스페이먼츠 시크릿 키"(live_sk_... / test_sk_...)와 전혀 다른 값이다.
# 이 프로젝트가 연동하는 곳은 토스페이먼츠(PG)가 아니라 토스플레이스(단말기/POS)이고,
# 이 키는 토스플레이스가 우리 서버로 보내는 웹훅의 HMAC 서명을 검증하는 용도다.
#
# 발급/설정 방법 (2026-08-24 문서 재확인, https://docs.tossplace.com/reference/open-api/webhook.html):
#   개발자센터 -> 내 애플리케이션 -> OpenAPI -> 웹훅 메뉴에서 직접 입력한다.
#   여기에 넣는 값과 이 환경변수 값이 같아야 서명 검증이 통과한다.
#   (예전 주석에는 "개발자센터에서 자체 설정이 안 되고 메일 문의가 필요하다"고 적혀 있었는데,
#    현재 문서 기준으로는 개발자센터에서 직접 설정할 수 있다. 값은 우리가 정하는 임의의 긴 랜덤 문자열이면 된다 —
#    예: `openssl rand -hex 32` 또는 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# ⚠️ NODE_ENV=production에서는 이제 필수값이다 — 비워두면 서버가 부팅 시점에 즉시 실패한다
# (서명 검증 없이 웹훅을 받는 상태로 운영에 올라가는 사고를 막기 위함). 로컬 개발(NODE_ENV != production)에서는
# 비워둬도 되며, 그 경우 서명 검증 없이(경고 로그만 남기고) 수신한다.
TOSS_WEBHOOK_SECRET=

# Cloud Scheduler가 프로모션 작업 endpoint를 호출할 때 사용하는 별도 공유 토큰.
# Cloud Run 서비스 전체를 공개 상태로 유지하면서 작업 endpoint만 인증하기 위해 사용한다.
# 같은 토큰으로 POST /internal/jobs/purge-expired(개인정보 보관기간 경과 파기)도 인증한다.
# 미설정 시 두 작업 endpoint 모두 503을 반환한다(운영에서는 필수지만 부팅 자체를 막지는 않음 — 경고 로그만 남음).
#
# ⚠️ 이 값을 채우는 것과 별개로, Cloud Scheduler 쪽에 실제 잡을 등록해야 두 endpoint가 호출된다.
# 서버 안에는 스케줄링 로직(node-cron 등)이 전혀 없으므로, 잡을 등록하지 않으면 이 토큰이 맞아도
# 아무도 endpoint를 부르지 않는다 — gcloud 등록 명령은 README.md의 "Cloud Scheduler 잡 등록 절차" 참고.
PROMOTION_JOB_TOKEN=

# 관리자 API(/api/admin/*, JWT가 필요한 라우트)에 허용할 오리진(콤마 구분, 예: https://admin.example.com,https://ops.example.com).
# 손님용 API(/api/reservations, /api/payments, /api/pos/*, /api/webhooks/*)는 토스 단말기가 매번 다른
# 로컬 오리진에서 접근하므로 이 제한과 무관하게 항상 전체 허용된다.
# 미설정 시 관리자 API도 전체 오리진 허용 상태로 열리며, production에서는 부팅 시 경고 로그가 남는다
# (막지는 않음 — 관리자 화면 도메인이 아직 확정되지 않은 초기 배포를 배려한 기본값).
ADMIN_ALLOWED_ORIGINS=

# 개인정보 보관기간(일). POST /internal/jobs/purge-expired가 이 기간보다 오래된 예약/결제 기록의
# 전화번호·차량번호를 익명화(파기)한다. 미설정 시 기본값 1095일(3년).
# ⚠️ 이 값과 §개인정보·광고성 정보 처리(README.md)의 문구는 아직 법무 검토 전이므로 운영 반영 전 확정 필요.
DATA_RETENTION_DAYS=1095

# 광고성 알림톡(3개월 후 프로모션) 맨 끝에 붙는 수신거부 안내 문구. 정보통신망법 제50조 대응으로
# 광고 문자 끝에 무료 수신거부 방법을 명시해야 한다. 미설정 시 기본값
# "무료수신거부: 매장으로 연락 주시면 즉시 처리해 드립니다." 사용.
# ⚠️ 문구가 실제로 법적 요건(수신거부 방법의 구체성 등)을 충족하는지 법무 검토 필요.
PROMO_OPT_OUT_TEXT=

# POST /internal/jobs/send-promotions 1회 실행당 최대 발송 건수(100건씩 배치 처리, 최대 50초 예산과
# 함께 상한 역할). 미설정 시 기본값 2000. Cloud Scheduler 호출 주기·예산 대비 대상자가 계속 밀리면 올릴 것.
PROMO_MAX_PER_RUN=2000

# 컨테이너 부팅 시 `npx prisma migrate deploy`를 자동 실행할지 여부(true/false). 기본값 true.
# Cloud Run처럼 콜드스타트마다 여러 인스턴스가 동시에 뜨는 환경에서는 매 부팅마다 마이그레이션을 걸면
# advisory lock 경합이 생기고, 마이그레이션이 실패하면 모든 인스턴스가 크래시 루프에 빠질 수 있다.
# 운영 권장: 배포 파이프라인의 별도 사전 단계(Cloud Run Job 등)에서 `prisma migrate deploy`를 한 번만
# 실행하고, 이 값을 false로 설정해 컨테이너는 마이그레이션 없이 바로 기동하게 한다. (Dockerfile 참고)
RUN_MIGRATIONS_ON_BOOT=true

# ── 쉐보레 전산(ERP) ↔ 토스 POS 주문 연동 ──────────────────────────────────
# 전산에서 "담기"를 누르면 우리 서버가 토스 POS에 미결제(OPENED) 주문을 대신 만들어주는 기능이다.
# 자세한 흐름은 README.md의 "쉐보레 전산(ERP) 연동" 섹션과 바탕화면
# `쉐보레전산-토스POS-연동스펙(초안).md` 참고.

# 토스 개발자센터 Open API 앱 `posmos-chevrolet-order`(서비스코드 AX4CEZY6)의 인증 정보.
# 이 앱으로 주문 생성 API 사용 승인을 이미 받았다(2026-08). 절대 로그에 남기지 말 것.
# 둘 중 하나라도 비어 있으면 `POST /api/erp/draft-orders`가 토스를 호출하는 시점에 502로 실패한다
# (서버 부팅 자체는 막지 않음 — 전산 연동 전에는 몰라도 되는 값이라서).
TOSS_OPENAPI_ACCESS_KEY=
TOSS_OPENAPI_SECRET_KEY=

# 쉐보레 전산이 `POST /api/erp/draft-orders`, `GET /api/erp/draft-orders/:referenceId`를 호출할 때
# 쓰는 공유 토큰(헤더 `X-ERP-Token`). 미설정 시 두 endpoint 모두 503(연동 미설정)을 반환한다.
# 발급은 우리가 임의의 긴 랜덤 문자열로 정하면 된다(예: `openssl rand -hex 32`) — 전산 측에는 이 값을
# 안전한 채널로 별도 전달할 것(이 파일이나 커밋에 실제 값을 남기지 말 것).
ERP_API_TOKEN=

# 토스 주문 생성 API의 `lineItems[].diningOption` 값. 미설정 시 기본값 `HERE`.
# 전체 허용 enum이 공개 문서에 없어서 처음엔 `FOR_HERE`로 추정했다가 실호출에서
# "diningOption는 유효하지 않은 값입니다"(4000) 400을 받았고, 공식 문서 요청 예시를 다시 확인해
# `HERE`가 맞는 값임을 확정했다(2026-08-26 실호출 검증). 다른 값이 필요해질 때 코드 수정 없이
# 운영자가 바꿀 수 있도록 환경변수로 남겨둔다.
TOSS_DINING_OPTION=HERE

# (선택) 토스 Open API Base URL. 기본값 `https://open-api.tossplace.com`이며 운영에서는 건드릴 일이 없다.
# 테스트 코드가 이 값을 로컬 목(mock) 서버 주소로 덮어써서 실제 토스 서버 없이 통합 테스트를 돌리는
# 용도로만 쓴다 — 운영 `.env`에는 비워둘 것.
TOSS_OPENAPI_BASE_URL=

# 전산(ERP) draft-orders 연동의 분당 요청 상한. 쉐보레 전산은 중계 서버 하나(IP 하나)를 통해
# 가맹점 400여 곳 요청이 전부 들어오므로, 매장 단위(storeCode)로 쪼갠 한도(ERP_STORE_LIMIT_PER_MIN)와
# 그걸 우회하는 폭주를 막는 IP 백스톱(ERP_IP_LIMIT_PER_MIN)이 따로 있다.
#
# ERP_STORE_LIMIT_PER_MIN — 매장 하나가 분당 보낼 수 있는 draft-orders 요청 수. 미설정 시 기본값 120
# (하루 8,000건을 영업 10시간에 나누면 분당 약 13건이 정상 유량이라, 120은 그 위에 충분한 여유를 둔
# "매장 하나가 넘으면 안 되는 천장"이다. 예상 유량이 아니다). 특정 매장의 정상적인 재시도/폴링 패턴이
# 이 한도에 자주 걸린다면(관리자 웹 [전산 주문 이력]에서 429 패턴 확인) 올리는 걸 검토한다.
ERP_STORE_LIMIT_PER_MIN=120

# ERP_IP_LIMIT_PER_MIN — storeCode를 계속 바꿔가며 매장별 한도를 우회하는 폭주를 막는 IP 기준
# 백스톱. 미설정 시 기본값 3000(분당, 초당 50건). 정상 유량(분당 500건 안쪽으로 추정)의 6배로 잡은
# 값이라 오탐 없이 폭주만 끊도록 넉넉하다 — "전산 트래픽이 몰린다"는 신고가 들어왔는데 정상 매장들의
# 요청까지 막히는 것 같으면(전체 전산 요청이 한꺼번에 429를 받으면) 이 값을 의심하고 올린다.
ERP_IP_LIMIT_PER_MIN=3000

# 인스턴스당 DB 커넥션 풀 상한. 미설정 시 5(backend/src/store.js 주석의 근거 참고).
# ⚠️ 이 값은 Cloud Run 최대 인스턴스 수를 정해둬야 의미가 있다 —
#    connection_limit <= (Cloud SQL max_connections - 20) / 최대 인스턴스 수
# DATABASE_URL에 connection_limit이 이미 있으면 그쪽이 우선한다.
DB_CONNECTION_LIMIT=

# 쿼리 하나가 DB에서 붙들 수 있는 시간(ms). 미설정 시 10000.
# Postgres가 서버 쪽에서 직접 취소하므로(statement_timeout) 커넥션이 즉시 반환된다.
# 이게 없으면 DB가 느려질 때 커넥션 풀이 말라 전 매장이 동시에 실패한다.
DB_STATEMENT_TIMEOUT_MS=
